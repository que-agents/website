---
// que's working mark: four dots that ripple, as in the app's sidebar. The day
// animation hides it for a session that is not working, and freezes it while
// paused (see DayAnimation.astro).
---

<span class="wm"><i></i><i></i><i></i><i></i></span>

<style>
  .wm {
    display: inline-grid;
    grid-template-columns: 3px 3px;
    gap: 2px;
    width: 8px;
    flex: none;
  }
  .wm i {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--accent);
    animation: day-ripple 1.2s ease-in-out infinite;
  }
  .wm i:nth-child(2),
  .wm i:nth-child(3) {
    animation-delay: 0.15s;
  }
  .wm i:nth-child(4) {
    animation-delay: 0.3s;
  }

  @keyframes day-ripple {
    0%,
    100% {
      opacity: 0.25;
    }
    50% {
      opacity: 1;
    }
  }
</style>
