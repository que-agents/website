<script>
  import { LOOP_TICKS, SPRITES, STEPS, TICK_MS, dayState, stepOf, stepTick } from '../lib/day'
  import type { DayState, TermLine } from '../lib/day'

  for (const root of document.querySelectorAll<HTMLElement>('[data-day]')) {
    mount(root)
  }

  function mount(root: HTMLElement) {
    const find = (scope: Element, selector: string): HTMLElement => {
      const el = scope.querySelector<HTMLElement>(selector)
      if (!el) {
        throw new Error(`DayAnimation: nothing matches ${selector}`)
      }
      return el
    }
    const ref = (name: string) => find(root, `[data-ref="${name}"]`)
    const caption = ref('caption')
    const person = ref('person')
    const sprite = ref('sprite')
    const lines = ref('lines')
    const deskDots = [...root.querySelectorAll<HTMLElement>('[data-ref="desk-dot"]')]
    const texts = {
      boardLabel: ref('board-label'),
      boardNow: ref('board-now'),
      boardUntil: ref('board-until'),
      boardCount: ref('board-count'),
      countdown: ref('countdown'),
      spin: ref('spin'),
      seconds: ref('seconds'),
      input: ref('input'),
      prs: ref('prs'),
      changes: ref('changes')
    }
    const sessions = new Map(
      [...root.querySelectorAll<HTMLElement>('.side-row')].map((side) => {
        const name = side.dataset.session ?? ''
        const board = find(root, `.board-row[data-session="${name}"]`)
        return [
          name,
          {
            side,
            dot: find(side, '.dot'),
            name: find(side, '.name'),
            board,
            word: find(board, '.word')
          }
        ]
      })
    )
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('button[data-step]')]
    let drawnLines = ''

    function lineElement(line: TermLine) {
      const el = document.createElement('div')
      el.className = 'line'
      el.dataset.kind = line.kind
      const pre = document.createElement('span')
      pre.className = 'pre'
      pre.textContent = line.pre
      const text = document.createElement('span')
      text.className = 'text'
      text.textContent = line.text
      el.append(pre, text)
      return el
    }

    function draw(s: DayState) {
      for (const [name, on] of Object.entries(s.flags)) {
        root.toggleAttribute(`data-${name}`, on)
      }
      caption.textContent = STEPS[s.step].caption
      buttons.forEach((button, i) => {
        if (i === s.step) {
          button.setAttribute('aria-current', 'step')
        } else {
          button.removeAttribute('aria-current')
        }
      })

      const p = s.person
      person.style.transitionDuration = `${p.walkSeconds}s`
      person.style.left = `${p.left}px`
      person.style.bottom = `${p.bottom}px`
      person.style.transform = p.facing === 'right' ? 'scaleX(-1)' : 'none'
      sprite.style.boxShadow = SPRITES[p.pose]
      deskDots.forEach((dot, i) => {
        dot.style.background = `var(--${s.deskDots[i]})`
      })

      for (const row of s.sessions) {
        const els = sessions.get(row.name)
        if (!els) {
          continue
        }
        els.side.toggleAttribute('data-working', row.working)
        els.side.toggleAttribute('data-selected', row.selected)
        els.dot.style.background = `var(--${row.dot})`
        els.name.style.color = `var(--${row.text})`
        els.board.toggleAttribute('data-working', row.working)
        els.word.textContent = row.word
      }

      texts.boardLabel.textContent = s.board.label
      texts.boardNow.textContent = s.board.now
      texts.boardUntil.textContent = s.board.until
      texts.boardCount.textContent = s.board.count
      texts.countdown.textContent = s.countdown
      texts.spin.textContent = `${s.terminal.spinner} ${s.terminal.verb}`
      texts.seconds.textContent = ` (${s.terminal.seconds}s · esc to interrupt)`
      texts.input.textContent = s.terminal.input
      texts.prs.textContent = s.prs
      texts.changes.textContent = s.changes

      const key = s.terminal.lines.map((line) => `${line.kind} ${line.pre}${line.text}`).join('\n')
      if (key !== drawnLines) {
        drawnLines = key
        lines.replaceChildren(...s.terminal.lines.map(lineElement))
      }
    }

    // The clock runs while the animation plays, is on screen and its tab is
    // showing. Paused, it stays on its frame and the timeline jumps to each
    // step's settled frame. With reduced motion it starts paused.
    const play = find(root, 'button[data-play]')
    const reduced = matchMedia('(prefers-reduced-motion: reduce)')
    let paused = reduced.matches
    let tick = stepTick(0, paused)
    let timer: number | undefined
    let onScreen = false

    const show = (t: number) => {
      tick = t
      draw(dayState(t))
    }
    const stop = () => {
      window.clearInterval(timer)
      timer = undefined
    }
    const sync = () => {
      const run = !paused && onScreen && !document.hidden
      if (run && timer === undefined) {
        timer = window.setInterval(() => show((tick + 1) % LOOP_TICKS), TICK_MS)
      } else if (!run && timer !== undefined) {
        stop()
      }
    }
    const setPaused = (value: boolean) => {
      paused = value
      root.toggleAttribute('data-paused', paused)
      play.setAttribute('aria-pressed', String(paused))
      play.setAttribute('aria-label', paused ? 'Play the animation' : 'Pause the animation')
      sync()
    }
    const jump = (step: number) => {
      stop()
      show(stepTick(step, paused))
      sync()
    }

    buttons.forEach((button, i) => button.addEventListener('click', () => jump(i)))
    play.addEventListener('click', () => setPaused(!paused))
    reduced.addEventListener('change', () => {
      setPaused(reduced.matches)
      if (paused) {
        jump(stepOf(tick))
      }
    })
    document.addEventListener('visibilitychange', sync)
    new IntersectionObserver((entries) => {
      onScreen = entries[entries.length - 1].isIntersecting
      sync()
    }).observe(root)

    // Each panel is scaled to the width its slot gets from the CSS below. Scaled,
    // the sprites' blocks overlap a little (--seam) so no hairlines show between them.
    const fit = new ResizeObserver((entries) => {
      for (const entry of entries) {
        const slot = entry.target as HTMLElement
        const panel = slot.firstElementChild as HTMLElement
        const scale = entry.contentRect.width / panel.offsetWidth
        slot.style.setProperty('--scale', String(scale))
        slot.style.setProperty('--seam', Math.abs(scale - 1) < 0.001 ? '0px' : '0.5px')
      }
    })
    root.querySelectorAll('[data-slot]').forEach((slot) => fit.observe(slot))

    setPaused(paused)
    show(tick)
  }
</script>

