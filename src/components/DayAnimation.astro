---
// The home page's "a day with que": a caption above a pixel scene beside que's
// window, and buttons to pause it and step through it. src/lib/day.ts decides
// what every tick shows; the
// script below only writes that into this markup, which is rendered at tick 0
// so the page shows a whole frame before the script runs.
//
// The scene and the window are drawn at their natural size, 440 × 460 and
// 650 × 460, and scaled down as a whole when there is less room (see .stage).
// The animation is always dark, in que's palette, whatever the site's theme.
import {
  HOME_BACK,
  HOME_FRONT,
  OFFICE_BACK,
  OFFICE_FRONT,
  PROJECTS,
  REPORT_ROWS,
  SPRITES,
  STEPS,
  dayState,
  type Px
} from '../lib/day'
import WorkingMark from './WorkingMark.astro'

const initial = dayState(0)
const { person, texts } = initial
const flags = Object.fromEntries(
  Object.entries(initial.flags)
    .filter(([, on]) => on)
    .map(([name]) => [`data-${name}`, ''])
)
const presence = (on: boolean) => (on ? '' : undefined)
const length = (size: Px['w']) => (typeof size === 'number' ? `${size}px` : size)
const place = (px: Px) =>
  `left: ${px.x}px; bottom: ${px.y}px; width: ${length(px.w)}; height: ${length(px.h)}` +
  (px.bg ? `; background: ${px.bg}` : '')

// Paths the window's line icons share: the folder, and the tab row's two split buttons.
const ICONS = {
  folder: 'M2 4.5h4l1.5 1.5H14v6.5H2z',
  splits: ['M8 3v10', 'M2 8h12']
}
---

<section class="day not-content" data-day aria-label="A day with que" {...flags}>
  <ol class="sr-only">
    {
      STEPS.map((step) => (
        <li>
          {step.time}. {step.caption} {step.shows}
        </li>
      ))
    }
  </ol>

  <p class="caption" aria-hidden="true" data-pagefind-ignore>
    {
      STEPS.map((step, i) => (
        <span data-caption data-current={presence(i === initial.step)}>
          {step.caption}
        </span>
      ))
    }
  </p>

  <div class="stage" aria-hidden="true" data-pagefind-ignore>
    <div class="panels">
      <div class="slot slot-scene" data-slot>
        <div class="scene">
          <div class="office">
            {OFFICE_BACK.map((px) => <div class:list={['px', px.cls]} style={place(px)} />)}
            <div class="figure colleague" style="left: 385px; bottom: 75px">
              <div class="sprite" style={`box-shadow: ${SPRITES.colleague}`}></div>
            </div>
          </div>
          <div class="home">
            {HOME_BACK.map((px) => <div class:list={['px', px.cls]} style={place(px)} />)}
          </div>

          <div
            class="figure person"
            data-ref="person"
            style={`left: ${person.left}px; bottom: ${person.bottom}px; transform: ${person.facing === 'right' ? 'scaleX(-1)' : 'none'}; transition-duration: ${person.walkSeconds}s`}
          >
            <div class="sprite" data-ref="sprite" style={`box-shadow: ${SPRITES[person.pose]}`}></div>
          </div>

          <div class="office">
            {OFFICE_FRONT.map((px) => <div class:list={['px', px.cls]} style={place(px)} />)}
            <div class="px desk-screen" style="left: 85px; bottom: 125px; width: 80px; height: 46px">
              <div class="desk-rows">
                <div class="px" style="left: 0; top: 0; bottom: 0; width: 22px; background: #111111">
                </div>
                {
                  initial.deskDots.map((tone, i) => (
                    <Fragment>
                      <div
                        class="px"
                        data-ref="desk-dot"
                        style={`left: 4px; top: ${8 + i * 7}px; width: 3px; height: 3px; background: var(--${tone})`}
                      />
                      <div
                        class="px"
                        style={`left: 9px; top: ${9 + i * 7}px; width: 10px; height: 1px; background: #6f6f6f`}
                      />
                    </Fragment>
                  ))
                }
                {
                  [
                    [8, 40, '#9b9b9b'],
                    [14, 30, '#6f6f6f'],
                    [20, 46, '#6f6f6f'],
                    [26, 22, '#6f6f6f']
                  ].map(([top, width, bg]) => (
                    <div
                      class="px"
                      style={`left: 27px; top: ${top}px; width: ${width}px; height: 2px; background: ${bg}`}
                    />
                  ))
                }
              </div>
              <div
                class="px desk-quiet"
                style="left: 38px; top: 21px; width: 4px; height: 4px; background: var(--accent)"
              >
              </div>
            </div>
            <div class="px chime" style="left: 160px; bottom: 182px">♪</div>
            <div class="px chime chime-late" style="left: 178px; bottom: 194px">♪</div>
            <div class="px dim" style="inset: 0"></div>
          </div>
          <div class="home">
            {HOME_FRONT.map((px) => <div class:list={['px', px.cls]} style={place(px)} />)}
          </div>
        </div>
      </div>

      <div class="slot slot-app" data-slot>
        <div class="app">
          <div class="lights"><i></i><i></i><i></i></div>

          <div class="board fade">
            <i class="corner" style="top: 8px; left: 8px"></i>
            <i class="corner" style="top: 8px; right: 8px"></i>
            <i class="corner" style="bottom: 8px; left: 8px"></i>
            <i class="corner" style="bottom: 8px; right: 8px"></i>
            <div class="board-head">
              <span class="board-title">
                <svg width="14" height="15" viewBox="300 290 488 514">
                  <circle
                    cx="482"
                    cy="472"
                    r="150"
                    fill="none"
                    style="stroke: var(--fg-muted)"
                    stroke-width="64"></circle>
                  <line
                    x1="632"
                    y1="472"
                    x2="632"
                    y2="772"
                    style="stroke: var(--fg-muted)"
                    stroke-width="64"
                    stroke-linecap="round"></line>
                  <circle cx="742" cy="742" r="46" style="fill: var(--accent)"></circle>
                </svg>
                <span class="lbl">[ <span data-text="boardLabel">{texts.boardLabel}</span> ]</span>
              </span>
              <span class="board-time">
                <span class="now" data-text="boardNow">{texts.boardNow}</span> · until <span
                  data-text="boardUntil">{texts.boardUntil}</span
                >
              </span>
            </div>
            <p class="board-count" data-text="boardCount">{texts.boardCount}</p>
            <div class="board-rows">
              {
                initial.sessions.map((row) => (
                  <div
                    class="session board-row"
                    data-session={row.name}
                    data-working={presence(row.working)}
                  >
                    <span class="mark">
                      <WorkingMark />
                      <span class="dot" style="background: var(--neutral)" />
                    </span>
                    <span class="name">{row.name}</span>
                    <span class="project">{row.project}</span>
                    <span class="spacer" />
                    <span class="word">{row.word}</span>
                    <span class="dash">–</span>
                  </div>
                ))
              }
            </div>
            <div class="board-foot">
              <span class="unlock">
                <svg class="icon" width="12" height="12" viewBox="0 0 16 16">
                  <rect x="3" y="7" width="10" height="7" rx="1"></rect>
                  <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0"></path>
                </svg>
                Unlock 20 min
              </span>
            </div>
          </div>

          <div class="window fade">
            <div class="side">
              <div class="side-top">
                <svg class="icon" width="14" height="14" viewBox="0 0 16 16">
                  <circle cx="7" cy="7" r="4.5"></circle>
                  <path d="m10.5 10.5 3 3" stroke-linecap="round"></path>
                </svg>
              </div>
              <div class="side-head">
                <span class="lbl">[ SESSIONS ]</span><span class="plus">+</span>
              </div>
              <div class="side-shell"><span class="shell-mark">›_</span>zsh</div>
              <div class="side-head projects">
                <span class="lbl">[ PROJECTS ]</span>
                <span class="side-icons">
                  <svg class="icon faint" width="13" height="13" viewBox="0 0 16 16">
                    <path d={ICONS.folder} stroke-linejoin="round"></path>
                  </svg>
                  <svg class="icon faint" width="13" height="13" viewBox="0 0 16 16">
                    <path d="M3 4h10M3 8h7M3 12h4" stroke-linecap="round"></path>
                  </svg>
                </span>
              </div>
              {
                PROJECTS.map((project) => (
                  <Fragment>
                    <div class="side-project">
                      <svg class="icon" width="13" height="13" viewBox="0 0 16 16">
                        <path d={ICONS.folder} stroke-linejoin="round" />
                      </svg>
                      {project}
                    </div>
                    {initial.sessions
                      .filter((row) => row.project === project)
                      .map((row) => (
                        <div
                          class="session side-row"
                          data-session={row.name}
                          data-working={presence(row.working)}
                          data-selected={presence(row.selected)}
                        >
                          <span class="mark">
                            <WorkingMark />
                            <span class="dot" style={`background: var(--${row.dot})`} />
                          </span>
                          <span class="name" style={`color: var(--${row.text})`}>
                            {row.name}
                          </span>
                        </div>
                      ))}
                  </Fragment>
                ))
              }
              <div class="side-foot">
                <div class="foot-quiet">
                  <span class="foot-word">Quiet</span>
                  <span class="pick">30m</span>
                  <span class="pick one-hour">1h</span>
                  <span class="pick">2h</span>
                  <svg class="pointer" width="12" height="16" viewBox="0 0 12 16">
                    <path
                      d="M1 1v12l3.2-3 2.3 5 1.8-.8-2.2-4.9H10z"
                      fill="#eeeeee"
                      stroke="#111111"
                      stroke-width="1"></path>
                  </svg>
                </div>
                <div class="foot-unlocked">
                  <svg
                    class="icon unlock-icon"
                    width="12"
                    height="12"
                    viewBox="0 0 16 16"
                    stroke-linecap="round"
                    stroke-linejoin="round">
                    <rect x="3" y="7.25" width="10" height="6.5" rx="1"></rect>
                    <path d="M5.25 7.25V5a2.75 2.75 0 0 1 5.4-.75"></path>
                  </svg>
                  <span><span data-text="countdown">{texts.countdown}</span> left</span>
                  <span class="lock-now">lock now</span>
                </div>
                <div class="foot-icons">
                  <svg class="icon report-icon" width="13" height="13" viewBox="0 0 16 16">
                    <path d="M3.5 1.5h9v13h-9z"></path>
                    <path d="M6 5h4M6 8h4M6 11h3"></path>
                  </svg>
                  <svg class="icon" width="13" height="13" viewBox="0 0 16 16">
                    <circle cx="8" cy="8" r="2.2"></circle>
                    <path
                      d="M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M3.4 12.6l1.4-1.4M11.2 4.8l1.4-1.4"
                      stroke-linecap="round"></path>
                  </svg>
                  <span class="spacer"></span>
                  <span class="usage">5h – wk –</span>
                </div>
              </div>
            </div>

            <div class="main">
              <div class="report">
                <div class="report-head">
                  <span class="lbl">[ REPORT ]</span>
                  <span class="note">18:00 – 08:00</span>
                </div>
                <p class="note">5 sessions · 2 pull requests · 1 waiting for you · 1 unlock</p>
                <div class="report-rows">
                  {
                    REPORT_ROWS.map((row, i) => (
                      <div class="report-row fade" style={`animation-delay: ${i * 0.15}s`}>
                        <span class="dot" style={`background: var(--${row.dot})`} />
                        <span class="name">{row.name}</span>
                        <span class="project">{row.project}</span>
                        <span class="spacer" />
                        <span class="tag" style={`color: var(--${row.tagTone})`}>
                          {row.tag}
                        </span>
                      </div>
                    ))
                  }
                </div>
                <p class="note">unlock 22:14 · 20 min</p>
              </div>

              <div class="term-view">
                <div class="tabs">
                  <div class="tab">claude</div>
                  <div class="tab-plus">+</div>
                  <span class="spacer"></span>
                  <div class="tab-tools">
                    {
                      ICONS.splits.map((split) => (
                        <svg class="icon faint" width="13" height="13" viewBox="0 0 16 16">
                          <rect x="2" y="3" width="12" height="10" rx="1" />
                          <path d={split} />
                        </svg>
                      ))
                    }
                  </div>
                </div>
                <div class="term">
                  <div class="scroll">
                    {/* Written by the script; at tick 0 the report view hides the terminal. */}
                    <div class="lines" data-ref="lines"></div>
                    <div class="permission fade">
                      <div class="ask">Bash command</div>
                      <div>{' '}</div>
                      <div class="fg">{'  npm run migrate'}</div>
                      <div class="muted">{'  Apply the invoices migration'}</div>
                      <div>{' '}</div>
                      <div class="fg">Do you want to proceed?</div>
                      <div class="ask-choice">❯ 1. Yes</div>
                      <div>{"  2. Yes, and don't ask again for npm run"}</div>
                      <div>{'     migrate commands in this project'}</div>
                      <div>{'  3. No, and tell Claude what to do'}</div>
                      <div>{'     differently (esc)'}</div>
                    </div>
                  </div>
                  <div class="status">
                    <span class="spin" data-text="spin">{texts.spin}</span>
                    <span class="faint" data-text="seconds">{texts.seconds}</span>
                  </div>
                  <div class="input-view">
                    <div class="input">
                      <span class="muted">{'> '}</span>
                      <span data-text="input">{texts.input}</span>
                      <span class="cursor"></span>
                    </div>
                    <div class="mode">
                      <span class="mode-on">{'  ⏵⏵ accept edits on'}</span>
                      <span class="faint">{' (shift+tab to cycle)'}</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="rail">
              <div class="rail-top">«</div>
              <div class="rail-rule"></div>
              <svg class="icon" width="14" height="14" viewBox="0 0 16 16">
                <circle cx="4.5" cy="3.5" r="1.5"></circle>
                <circle cx="4.5" cy="12.5" r="1.5"></circle>
                <circle cx="11.5" cy="12.5" r="1.5"></circle>
                <path d="M4.5 5v6M11.5 11V6.5L9.5 4.5"></path>
              </svg>
              <span class="rail-count" data-text="prs">{texts.prs}</span>
              <svg class="icon" width="14" height="14" viewBox="0 0 16 16">
                <path d="M3.5 1.5h6l3 3v10h-9z" stroke-linejoin="round"></path>
                <path d="M6 7h4M8 5v4M6 11.5h4"></path>
              </svg>
              <span class="rail-count" data-text="changes">{texts.changes}</span>
              <svg class="icon" width="14" height="14" viewBox="0 0 16 16">
                <path d={ICONS.folder} stroke-linejoin="round"></path>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>


  <div class="controls">
    <button type="button" data-prev aria-label="Previous step">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path
          d="M10 3.5 5.5 8l4.5 4.5"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>
    <button type="button" data-play aria-label="Pause the animation">
      <svg class="icon-pause" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M5.5 3.5v9M10.5 3.5v9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
        ></path>
      </svg>
      <svg class="icon-play" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M5.5 3.25v9.5L13 8z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"
        ></path>
      </svg>
    </button>
    <button type="button" data-next aria-label="Next step">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path
          d="M6 3.5 10.5 8 6 12.5"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>
  <p class="sr-only" role="status" data-announce></p>
</section>

<script>
  import { LOOP_TICKS, SPRITES, STEPS, TICK_MS, dayState, stepOf, stepTick } from '../lib/day'
  import type { DayState, TermLine } from '../lib/day'

  for (const root of document.querySelectorAll<HTMLElement>('[data-day]')) {
    mount(root)
  }

  function mount(root: HTMLElement) {
    const find = (scope: Element, selector: string): HTMLElement => {
      const el = scope.querySelector<HTMLElement>(selector)
      if (!el) {
        throw new Error(`DayAnimation: nothing matches ${selector}`)
      }
      return el
    }
    const ref = (name: string) => find(root, `[data-ref="${name}"]`)
    const person = ref('person')
    const sprite = ref('sprite')
    const lines = ref('lines')
    const deskDots = [...root.querySelectorAll<HTMLElement>('[data-ref="desk-dot"]')]
    const texts = new Map(
      [...root.querySelectorAll<HTMLElement>('[data-text]')].map((el) => [el.dataset.text, el])
    )
    const sessions = new Map(
      [...root.querySelectorAll<HTMLElement>('.side-row')].map((side) => {
        const name = side.dataset.session ?? ''
        const board = find(root, `.board-row[data-session="${name}"]`)
        return [
          name,
          {
            side,
            dot: find(side, '.dot'),
            name: find(side, '.name'),
            board,
            word: find(board, '.word')
          }
        ]
      })
    )
    const captions = [...root.querySelectorAll<HTMLElement>('[data-caption]')]
    let drawnLines = ''

    // What each element was last given, so a tick touches the page only where
    // something changed.
    const written = new WeakMap<Element, Map<string, string | null>>()
    const changed = (el: Element, key: string, value: string | null) => {
      const last = written.get(el) ?? new Map<string, string | null>()
      written.set(el, last)
      if (last.has(key) && last.get(key) === value) {
        return false
      }
      last.set(key, value)
      return true
    }
    const setText = (el: HTMLElement, value: string) => {
      if (changed(el, 'text', value)) {
        el.textContent = value
      }
    }
    const setStyle = (el: HTMLElement, property: string, value: string) => {
      if (changed(el, `style ${property}`, value)) {
        el.style.setProperty(property, value)
      }
    }
    const setAttr = (el: Element, name: string, value: string | null) => {
      if (changed(el, `attr ${name}`, value)) {
        if (value === null) {
          el.removeAttribute(name)
        } else {
          el.setAttribute(name, value)
        }
      }
    }
    const presence = (on: boolean) => (on ? '' : null)

    function lineElement(line: TermLine) {
      const el = document.createElement('div')
      el.className = 'line'
      el.dataset.kind = line.kind
      const pre = document.createElement('span')
      pre.className = 'pre'
      pre.textContent = line.pre
      const text = document.createElement('span')
      text.className = 'text'
      text.textContent = line.text
      el.append(pre, text)
      return el
    }

    function draw(s: DayState) {
      for (const [name, on] of Object.entries(s.flags)) {
        setAttr(root, `data-${name}`, presence(on))
      }
      captions.forEach((caption, i) => setAttr(caption, 'data-current', presence(i === s.step)))
      for (const [name, value] of Object.entries(s.texts)) {
        const el = texts.get(name)
        if (el) {
          setText(el, value)
        }
      }

      const p = s.person
      setStyle(person, 'transition-duration', `${p.walkSeconds}s`)
      setStyle(person, 'left', `${p.left}px`)
      setStyle(person, 'bottom', `${p.bottom}px`)
      setStyle(person, 'transform', p.facing === 'right' ? 'scaleX(-1)' : 'none')
      setStyle(sprite, 'box-shadow', SPRITES[p.pose])
      deskDots.forEach((dot, i) => setStyle(dot, 'background', `var(--${s.deskDots[i]})`))

      for (const row of s.sessions) {
        const els = sessions.get(row.name)
        if (!els) {
          continue
        }
        setAttr(els.side, 'data-working', presence(row.working))
        setAttr(els.side, 'data-selected', presence(row.selected))
        setStyle(els.dot, 'background', `var(--${row.dot})`)
        setStyle(els.name, 'color', `var(--${row.text})`)
        setAttr(els.board, 'data-working', presence(row.working))
        setText(els.word, row.word)
      }

      const key = s.lines.map((line) => `${line.kind} ${line.pre}${line.text}`).join('\n')
      if (key !== drawnLines) {
        drawnLines = key
        lines.replaceChildren(...s.lines.map(lineElement))
      }
    }

    // The clock runs while the animation plays, is on screen and its tab is
    // showing. Paused, it stays on its frame. With reduced motion it starts
    // paused, on the first step's settled frame.
    const play = find(root, 'button[data-play]')
    const reduced = matchMedia('(prefers-reduced-motion: reduce)')
    let paused = reduced.matches
    let tick = stepTick(0, paused)
    let timer: number | undefined
    let onScreen = false

    const show = (t: number) => {
      tick = t
      draw(dayState(t))
    }
    const stop = () => {
      window.clearInterval(timer)
      timer = undefined
    }
    const sync = () => {
      const run = !paused && onScreen && !document.hidden
      if (run && timer === undefined) {
        timer = window.setInterval(() => show((tick + 1) % LOOP_TICKS), TICK_MS)
      } else if (!run && timer !== undefined) {
        stop()
      }
    }
    const setPaused = (value: boolean) => {
      paused = value
      root.toggleAttribute('data-paused', paused)
      play.setAttribute('aria-label', paused ? 'Play the animation' : 'Pause the animation')
      sync()
    }
    const jump = (step: number) => {
      stop()
      show(stepTick(step, paused))
      sync()
    }

    // Stepping by hand says where it landed, for screen readers; the clock's own
    // steps stay quiet.
    const announce = find(root, '[data-announce]')
    const stepBy = (by: number) => {
      const to = (stepOf(tick) + by + STEPS.length) % STEPS.length
      jump(to)
      announce.textContent = `${STEPS[to].time}. ${STEPS[to].caption}`
    }

    play.addEventListener('click', () => setPaused(!paused))
    find(root, 'button[data-prev]').addEventListener('click', () => stepBy(-1))
    find(root, 'button[data-next]').addEventListener('click', () => stepBy(1))
    reduced.addEventListener('change', () => {
      setPaused(reduced.matches)
      if (paused) {
        jump(stepOf(tick))
      }
    })
    document.addEventListener('visibilitychange', sync)
    new IntersectionObserver((entries) => {
      onScreen = entries[entries.length - 1].isIntersecting
      sync()
    }).observe(root)

    // Each panel is scaled to the width its slot gets from the CSS below. Scaled,
    // the sprites' blocks overlap a little (--seam) so no hairlines show between them.
    const fit = new ResizeObserver((entries) => {
      for (const entry of entries) {
        const slot = entry.target as HTMLElement
        const panel = slot.firstElementChild as HTMLElement
        const scale = entry.contentRect.width / panel.offsetWidth
        slot.style.setProperty('--scale', String(scale))
        slot.style.setProperty('--seam', Math.abs(scale - 1) < 0.001 ? '0px' : '0.5px')
      }
    })
    root.querySelectorAll('[data-slot]').forEach((slot) => fit.observe(slot))

    setPaused(paused)
    show(tick)
  }
</script>

