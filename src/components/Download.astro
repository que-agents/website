---
// The download button for the latest que release. Everything it shows comes
// from src/data/release.json, which scripts/fetch-release.mjs writes at build time.
import release from '../data/release.json'

interface Props {
  /** The home page's version: centred, beside a Docs button, with no release line. */
  hero?: boolean
}

const { hero = false } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const date = new Date(release.publishedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC'
})
---

{
  hero ? (
    <div class="download hero-actions not-content">
      <a class="button" href={release.dmg.url}>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M8 2v8M4.5 6.5 8 10l3.5-3.5M3 13h10"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        Download for macOS
      </a>
      <a class="button secondary" href={`${base}/guides/overview/`}>Docs</a>
    </div>
  ) : (
    <div class="download not-content">
      <div class="row">
        <a class="button" href={release.dmg.url}>Download for macOS</a>
        <span class="meta">
          <a href={release.url}>que {release.version}</a> · <time datetime={release.publishedAt}>{date}</time>
        </span>
      </div>
      <p class="meta">
        <a href={`${base}/guides/install/#first-launch`}>Apple Silicon · unsigned build</a>
        {' · '}
        <a href="https://github.com/que-agents/que/releases">All releases</a>
      </p>
    </div>
  )
}

<style>
  .download {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-block: 1.5rem;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }
  /* The one primary button on the page: light on dark (que's --inverse). */
  .button {
    padding: 0.5rem 1rem;
    border: 1px solid var(--sl-color-white);
    border-radius: 2px;
    background: var(--sl-color-white);
    color: var(--sl-color-black);
    font-weight: 600;
    text-decoration: none;
  }
  .button:hover {
    border-color: var(--sl-color-gray-2);
    background: var(--sl-color-gray-2);
  }
  .meta {
    margin: 0;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .meta a {
    color: inherit;
  }
  .meta a:hover {
    color: var(--sl-color-text-accent);
  }

  /* Under the home page's hero: two larger buttons side by side, centred. */
  .hero-actions {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-block: 0;
  }
  .hero-actions .button {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 44px;
    padding: 0.75rem 1.25rem;
    font-size: 0.9375rem;
    line-height: 1.25;
  }
  /* The secondary button: an outline (que's --border-strong) that fills on hover. */
  .hero-actions .secondary {
    border-color: var(--sl-color-gray-5);
    background: transparent;
    color: var(--sl-color-white);
    font-weight: 400;
  }
  .hero-actions .secondary:hover {
    border-color: var(--sl-color-gray-5);
    background: var(--sl-color-bg-inline-code);
  }
</style>
