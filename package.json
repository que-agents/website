{
  "name": "que-website",
  "version": "0.0.0",
  "private": true,
  "description": "The source for que-agents.com: que's docs and downloads.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/que-agents/website.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "fetch-release": "node scripts/fetch-release.mjs",
    "predev": "npm run fetch-release",
    "dev": "astro dev",
    "prebuild": "npm run fetch-release",
    "build": "astro build",
    "preview": "astro preview",
    "precheck": "npm run fetch-release",
    "check": "astro check",
    "test": "vitest run",
    "format": "oxfmt --write --ignore-path .gitignore --ignore-path .oxfmtignore .",
    "lint": "oxlint && oxfmt --check --ignore-path .gitignore --ignore-path .oxfmtignore .",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.7",
    "astro": "^7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@oxlint/plugins": "1.88.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "1.88.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,mjs,js}": [
      "oxlint --no-error-on-unmatched-pattern",
      "oxfmt --write --no-error-on-unmatched-pattern --ignore-path .gitignore --ignore-path .oxfmtignore"
    ],
    "*.astro": [
      "oxlint --no-error-on-unmatched-pattern"
    ],
    "*.{css,md,mdx,json,yml,yaml}": [
      "oxfmt --write --no-error-on-unmatched-pattern --ignore-path .gitignore --ignore-path .oxfmtignore"
    ]
  }
}
